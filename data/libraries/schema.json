{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raman-studio/band-library@1",
  "title": "Raman Studio band library",
  "description": "One material's Raman band data. Text fields may contain simple inline HTML (<b>, <i>, <sub>, <sup>, <span class='mono'>), which the app renders through an allowlist.",
  "type": "object",
  "required": ["schema", "id", "name", "bands"],
  "properties": {
    "schema": { "const": "raman-studio/band-library@1" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Stable id; also the file name without .json." },
    "name": { "type": "string" },
    "material": { "type": "string" },
    "source": {
      "type": "object",
      "description": "Where the data came from (title, url, repo, commit …).",
      "properties": { "title": { "type": "string" }, "url": { "type": "string" } }
    },
    "referenceExcitation": {
      "type": "object",
      "description": "Excitation wavelength the band positions assume. Used to shift dispersive bands for other lasers.",
      "required": ["nm"],
      "properties": {
        "nm": { "type": ["number", "null"] },
        "status": { "enum": ["stated", "assumed"] },
        "note": { "type": "string" }
      }
    },
    "matchDefaults": {
      "type": "object",
      "properties": {
        "toleranceCm": { "type": "number", "minimum": 0 },
        "unknownDispersionAllowanceCmPerEV": { "type": "number", "minimum": 0 }
      }
    },
    "fitDefaults": {
      "type": "object",
      "properties": {
        "fwhmMin": { "type": "number", "exclusiveMinimum": 0 },
        "fwhmMax": { "type": "number", "exclusiveMinimum": 0 },
        "gaussianPercentSeed": { "type": "number", "minimum": 0, "maximum": 100 },
        "windowPadCm": { "type": "number", "minimum": 0 },
        "modelSelection": {
          "type": "object",
          "required": ["criterion", "optional"],
          "properties": {
            "criterion": { "enum": ["BIC"] },
            "optional": { "type": "array", "items": { "type": "string" }, "maxItems": 4 },
            "closeCall": { "type": "number", "minimum": 0 },
            "note": { "type": "string" }
          }
        }
      }
    },
    "atlasNotes": { "type": "object", "additionalProperties": { "type": "string" } },
    "bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "name", "region", "posText", "posSort", "match"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string", "description": "Short symbol drawn on the plot, e.g. 'D′'." },
          "name": { "type": "string" },
          "region": { "enum": ["first", "second"], "description": "First- or second-order region; deconvolution fits each region separately." },
          "order": { "type": "string" },
          "activated": { "type": "string" },
          "sym": { "type": "string" },
          "posText": { "type": "string", "description": "Position as written in the source, e.g. '~1580–1600 cm⁻¹'." },
          "posSort": { "type": "number", "description": "Representative centre, cm⁻¹." },
          "plot": {
            "type": "object",
            "description": "Schematic curve from the source (mu, A, sig). Used for demo spectra and as fit seed widths.",
            "properties": { "mu": { "type": "number" }, "A": { "type": "number" }, "sig": { "type": "number" } }
          },
          "origin": { "type": "string" },
          "use": { "type": "string" },
          "process": { "type": "string" },
          "mechanism": { "type": "string" },
          "meaning": { "type": "string" },
          "diagnostics": { "type": "string" },
          "correction": { "type": "string" },
          "refs": { "type": "array", "items": { "type": "string" }, "description": "Keys into `references`." },
          "match": {
            "type": "object",
            "required": ["range", "center", "dispersion"],
            "properties": {
              "range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "center": { "type": "number" },
              "dispersion": {
                "type": "object",
                "required": ["cmPerEV"],
                "properties": {
                  "cmPerEV": { "type": ["number", "null"], "description": "Shift per eV of laser energy; null = unknown (window is widened instead)." },
                  "stated": { "type": "boolean" },
                  "widenWindow": { "type": "boolean" },
                  "source": { "type": "string" }
                }
              }
            }
          },
          "fit": {
            "type": "object",
            "properties": { "fwhmSeed": { "type": "number", "exclusiveMinimum": 0 }, "source": { "type": "string" } }
          }
        }
      }
    },
    "regions": {
      "type": "array",
      "description": "Spectral windows that are not bands (e.g. the sp³ C–H stretching region). Peaks there are tagged, not band-labelled.",
      "items": {
        "type": "object",
        "required": ["id", "label", "range"],
        "properties": {
          "id": { "type": "string" }, "label": { "type": "string" }, "name": { "type": "string" },
          "range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "kind": { "type": "string" }, "text": { "type": "string" }, "source": { "type": "string" }
        }
      }
    },
    "ratios": {
      "type": "array",
      "description": "Intensity-ratio guide cards: n (name), t (title), b (lead), eqs, note, refs.",
      "items": { "type": "object", "required": ["n"] }
    },
    "ratioMap": {
      "type": "array",
      "description": "How to compute each ratio card from band ids.",
      "items": {
        "type": "object",
        "required": ["ratioIndex", "num", "den", "measures"],
        "properties": {
          "ratioIndex": { "type": "integer", "minimum": 0 },
          "num": { "type": "string" }, "den": { "type": "string" },
          "measures": { "type": "array", "items": { "enum": ["height", "area"] } },
          "extras": { "type": "array", "items": { "type": "string" } },
          "classify": { "type": "object" }
        }
      }
    },
    "workflow": { "type": "array", "items": { "type": "string" }, "description": "Read-your-spectrum decision steps." },
    "references": {
      "type": "object",
      "description": "Reference key → { c: citation, u: url, cc: citation count, n: 1 if added during review }.",
      "additionalProperties": {
        "type": "object",
        "required": ["c"],
        "properties": { "c": { "type": "string" }, "u": { "type": "string" }, "cc": { "type": "string" }, "n": { "type": "integer" } }
      }
    }
  }
}
